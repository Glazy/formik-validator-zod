{
  "name": "formik-validator-zod",
  "version": "3.0.0",
  "description": "Helper to simplify validating Formik values with Zod",
  "type": "module",
  "types": "./dist/esm/index.d.ts",
  "exports": {
    "import": "./dist/esm/index.js",
    "require": "./dist/cjs/index.js"
  },
  "scripts": {
    "prepare": "husky install",
    "build:esm": "tsc -p tsconfig.esm.json",
    "build:cjs": "tsc -p tsconfig.cjs.json && echo '{\"type\":\"commonjs\"}' > dist/cjs/package.json",
    "build": "npm-run-all -p build:esm build:cjs",
    "test": "vitest"
  },
  "keywords": [
    "zod",
    "formik",
    "forms",
    "schema",
    "validation"
  ],
  "author": "Luke Glazebrook <Glazy@users.noreply.github.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Glazy/formik-validator-zod.git"
  },
  "license": "MIT",
  "devDependencies": {
    "formik": "^2.2.9",
    "husky": "^8.0.0",
    "npm-run-all": "^4.1.5",
    "pretty-quick": "^3.1.3",
    "typescript": "^5.9.3",
    "vitest": "^0.24.3",
    "zod": "^4.0.0"
  },
  "peerDependencies": {
    "formik": "^2.2.9",
    "zod": "^4.0.0"
  },
  "dependencies": {
    "deepmerge": "^4.3.1"
  }
}
